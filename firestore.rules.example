rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /damaRooms/{roomId} {
      // Authentication is required to read a room or attempt to join it.
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.guestUid == null
        && request.resource.data.guestConnected == false
        && request.resource.data.keys().hasAll([
          'board', 'turn', 'gameOver', 'captures', 'updatedAt',
          'hostUid', 'guestUid', 'hostConnected', 'guestConnected', 'createdAt'
        ]);

      allow update: if request.auth != null
        && request.resource.data.hostUid == resource.data.hostUid
        && (
          // Existing host or guest may update game state.
          resource.data.hostUid == request.auth.uid
          || resource.data.guestUid == request.auth.uid
          // One authenticated user may claim an empty guest seat.
          || (
            resource.data.guestUid == null
            && resource.data.guestConnected == false
            && request.resource.data.guestUid == request.auth.uid
            && request.resource.data.guestConnected == true
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['guestUid', 'guestConnected'])
          )
        );

      allow delete: if request.auth != null
        && resource.data.hostUid == request.auth.uid;
      // Chat messages, virtual gifts and WebRTC call signaling are limited to room members.
      match /chat/{messageId} {
        allow read: if request.auth != null
          && (request.auth.uid == get(/databases/$(database)/documents/damaRooms/$(roomId)).data.hostUid
            || request.auth.uid == get(/databases/$(database)/documents/damaRooms/$(roomId)).data.guestUid);
        allow create: if request.auth != null
          && (request.auth.uid == get(/databases/$(database)/documents/damaRooms/$(roomId)).data.hostUid
            || request.auth.uid == get(/databases/$(database)/documents/damaRooms/$(roomId)).data.guestUid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.createdAt is int
          && (request.resource.data.type == 'text' || request.resource.data.type == 'gift')
          && (request.resource.data.type != 'text' || (request.resource.data.text is string && request.resource.data.text.size() <= 300));
        allow update, delete: if false;
      }
      match /gifts/{giftId} {
        allow read: if request.auth != null
          && (request.auth.uid == get(/databases/$(database)/documents/damaRooms/$(roomId)).data.hostUid
            || request.auth.uid == get(/databases/$(database)/documents/damaRooms/$(roomId)).data.guestUid);
        allow create: if request.auth != null
          && (request.auth.uid == get(/databases/$(database)/documents/damaRooms/$(roomId)).data.hostUid
            || request.auth.uid == get(/databases/$(database)/documents/damaRooms/$(roomId)).data.guestUid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.gift is string
          && request.resource.data.giftName is string
          && request.resource.data.createdAt is int;
        allow update, delete: if false;
      }
      match /iceHost/{candidateId} {
        allow read, create: if request.auth != null
          && (request.auth.uid == get(/databases/$(database)/documents/damaRooms/$(roomId)).data.hostUid
            || request.auth.uid == get(/databases/$(database)/documents/damaRooms/$(roomId)).data.guestUid)
          && (request.method != 'create' || request.resource.data.from == request.auth.uid);
        allow update, delete: if false;
      }
      match /iceGuest/{candidateId} {
        allow read, create: if request.auth != null
          && (request.auth.uid == get(/databases/$(database)/documents/damaRooms/$(roomId)).data.hostUid
            || request.auth.uid == get(/databases/$(database)/documents/damaRooms/$(roomId)).data.guestUid)
          && (request.method != 'create' || request.resource.data.from == request.auth.uid);
        allow update, delete: if false;
      }
      match /signal/{signalId} {
        allow read: if request.auth != null
          && (request.auth.uid == get(/databases/$(database)/documents/damaRooms/$(roomId)).data.hostUid
            || request.auth.uid == get(/databases/$(database)/documents/damaRooms/$(roomId)).data.guestUid);
        allow create: if request.auth != null
          && (request.auth.uid == get(/databases/$(database)/documents/damaRooms/$(roomId)).data.hostUid
            || request.auth.uid == get(/databases/$(database)/documents/damaRooms/$(roomId)).data.guestUid)
          && request.resource.data.from == request.auth.uid
          && request.resource.data.type in ['offer','answer']
          && request.resource.data.to is string
          && request.resource.data.sdp is map;
        allow update: if request.auth != null
          && (request.auth.uid == get(/databases/$(database)/documents/damaRooms/$(roomId)).data.hostUid
            || request.auth.uid == get(/databases/$(database)/documents/damaRooms/$(roomId)).data.guestUid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        allow delete: if false;
      }

    }
  }
}
